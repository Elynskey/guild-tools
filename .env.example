# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# All of these are read only by the Electron main process (electron/main.cjs and
# electron/dataSources/*), never bundled into the renderer/frontend code.

GUILD_NAME="Casual Raid Days"
GUILD_REALM="The Scryers"
GUILD_REGION="us"

# Real current-tier zone name as it appears in Warcraft Logs (must match exactly —
# used to filter reports to the current tier for tier-to-date aggregation).
TIER_ZONE_NAME="The Venomous Abyss"

# Guild's minimum DPS requirement (dps role only — tanks have none, healers use
# percentile since healing load varies too much by pull for a flat minimum to be
# fair). Raise this yourself in .env as the tier progresses.
MIN_DPS_REQUIREMENT=80000

# Warcraft Logs API client (OAuth client-credentials). Create one at
# https://www.warcraftlogs.com/api/clients/ — leave "Public Client" unchecked.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# wowaudit management API key, from your team's Settings/API page in wowaudit.
# Note: wowaudit's public API does not expose enchant/gem/socket data (verified) —
# it's used here for roster membership + role/rank, not gearCompletion.
WOWAUDIT_API_KEY=
# Optional — the app reads the team ID straight from /v1/team using just the API
# key above, so this is only a sanity-check cross-reference if you happen to know it.
WOWAUDIT_TEAM_ID=

# Battle.net Game Data API (OAuth client-credentials), for real gear/enchant/gem
# completion data. Create one at https://develop.battle.net -> API Access -> My Client.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# Discord sign-in + guild-membership check + notification foundation. Create an
# application at https://discord.com/developers/applications, add a Bot, and invite it
# to the CRD server. DISCORD_GUILD_ID is the CRD server's ID; DISCORD_CHANNEL_ID is
# only needed for the (currently unused) notify foundation. Redirect URI to register:
# http://localhost:53136/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
